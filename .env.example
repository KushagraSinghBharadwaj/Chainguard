# Copy to backend/.env and fill in. NEVER commit the real .env file.
# Secrets are intentionally blank. Non-secret settings show their defaults.

DATABASE_URL=
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
RPC_URL_ETHEREUM=
LOG_LEVEL=INFO

# Rate limits (burst and sustained requests per minute)
RATE_LIMIT_TOKEN_BURST=30
RATE_LIMIT_TOKEN_PER_MINUTE=30
RATE_LIMIT_IP_BURST=60
RATE_LIMIT_IP_PER_MINUTE=60
# Set true only behind a reverse proxy you control
TRUST_PROXY_HEADERS=false
