{
  "manifest_version": 3,
  "name": "ChainGuard",
  "version": "0.2.0",
  "description": "Read-only risk checks for wallets, tokens and transactions. Never asks for keys or signs anything.",
  "action": { "default_popup": "popup.html" },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
